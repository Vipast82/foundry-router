# setup-host.sh writes this file for you (/srv/studio-slot/slot.env, linked as .env here) from the
# router's slot settings; this example only shows what it contains. To change it, change the slot on
# Access → Machines / Automation → Settings and re-run the installer with a new code.
# the slot's own place: create a private experience per slot (e.g. "Animal Uprising [SLOT-2]")
# and paste its ids; the window title must contain [SLOT- (studio-reopen / the full-screen rule)
STUDIO_OPEN=roblox-studio:1+launchmode:edit+task:EditPlace+placeId:<PLACE_ID>+universeId:<UNIVERSE_ID>
SLOT_CONTAINER=studio-slot
# the Foundry router this slot pulls its secrets and settings from (Setup → Secrets), and the slot's
# id there (its key file goes in /srv/studio-slot/slot-key/slot-key.txt)
FOUNDRY_URL=http://192.168.0.112:11435
# with the router's HTTPS listener: FOUNDRY_URL=https://192.168.0.112:11436 and its fingerprint
FOUNDRY_TLS_FINGERPRINT=
FOUNDRY_PROJECT=animaluprising
FOUNDRY_SLOT=slot-2
SLOT_NOVNC_PORT=6080
SLOT_CPUS=6
SLOT_MEM=12g
# 1 only with enough memory for edit + server + 2 clients (about 14+ GB in software rendering)
SLOT_MULTIPLAYER=0
