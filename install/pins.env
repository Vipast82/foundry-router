# The tool versions every Foundry machine installs, in one place: the workstation and junction
# installers (install/workstation.sh, install/workstation.ps1), the Windows slot installer
# (install/slot.ps1), the slot image (contrib/studio-slot/Dockerfile: its ARG lines keep the
# same values as their defaults) and CI (.github/workflows/platform.yml).
# tests/test_junction_install.py fails when any copy differs from this file: change a version
# here AND in each copy it names, in one commit.
#
# KEY=value lines only (sourced by bash, read by PowerShell); no spaces around "=".

# Node.js (Linux: the tarball, checked against nodejs.org's SHASUMS256.txt; Windows: winget)
NODE_VERSION=22.21.0
# the coding clients: npm packages, checked against the registry's integrity before installing
KILO_VERSION=7.8.32
KILO_INTEGRITY=sha512-lbW+z4wMioOFejeJy0eSEdaYj9BdOt/QUbQMVLFmuaqJSluBSxlmJPSEaHCKrwU/7NVEH1wnA/K1o1Ol9nWz2A==
OPENCODE_VERSION=2.3.2
OPENCODE_INTEGRITY=sha512-U/DD6X8kgnEFM3VYT7+QN/UJotW++qOxTJtPEUiNzKwu9tNHtAC1jOtup1gpk773j0AFNmMBbLNou4YkdvlRKA==
# PowerShell 7 (the game's gate host half, tools/gate.ps1): the Linux tarball's SHA-256;
# Windows: winget Microsoft.PowerShell at this version
PWSH_VERSION=7.6.9
PWSH_SHA256=1da6d6d6035d651f20e70ddee7c4c15ac6ab8b9fb40ee92240d91263f28a884b
# rokit (the game's lune, selene, stylua, wally): the Linux zip's SHA-256. No Windows build is
# pinned yet (ROKIT_WINDOWS_SHA256 empty): workstation.ps1 then uses a rokit already on PATH
# and says how to add one, instead of running an unchecked download
ROKIT_VERSION=1.2.0
ROKIT_SHA256=951a7f3ec3d2a5e021fd1867d32f69f010ee4c2927f644b759578afc59c65fc0
ROKIT_WINDOWS_SHA256=
# Blender 4.5 LTS for asset sprints (Linux tarball)
BLENDER_VERSION=4.5.12
BLENDER_SHA256=95e3a2dfedba3bd32ca54fc355eac6b15a11986954ccb02815a07535d0120a25
# Python for the Windows installers (winget Python.Python.3.12 at this version)
PYTHON_WINDOWS_VERSION=3.12.10
